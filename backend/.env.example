# Backend settings. These are read from ENVIRONMENT VARIABLES (this file is only a reference).
# On Render: Dashboard -> your service -> Environment -> add each one.
# Never commit real values to GitHub.

# Neon connection string (Neon dashboard -> Connection Details). Leave unset locally to use SQLite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Signs login tokens. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-a-long-random-string-here

# Your Vercel URL (no trailing slash). Several? Separate with commas.
ALLOWED_ORIGINS=https://your-site.vercel.app

# Razorpay Dashboard -> Test Mode -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
